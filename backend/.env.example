# ---------------------------------------------------------------------------
# QuoteFlow backend configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

APP_ENV=development
DEBUG=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=quoteflow

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Quotation document verification (HMAC pepper for verification hashes)
VERIFICATION_SECRET=change-me-verification-secret

# CORS (comma separated, used by the React dev server later)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage for generated PDFs
PDF_STORAGE_DIR=storage/quotations
