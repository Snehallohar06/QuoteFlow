# Base URL for the backend API.
# Left blank in development so requests go through the Vite dev-server proxy
# (see vite.config.js) and stay same-origin. Set it to the deployed API origin
# for a production build, e.g. https://api.quoteflow.example
VITE_API_BASE_URL=

# Where the dev-server proxy forwards /api to.
VITE_PROXY_TARGET=http://127.0.0.1:8000
